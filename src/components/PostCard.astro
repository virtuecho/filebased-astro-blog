---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, tagUrl } from '../lib';
import { copy } from '../site.config';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const url = postUrl(post);
const showCategory = post.data.category !== copy.contentDefaults.category;
---

<article class="post-card">
  <div>
    <h2 class="post-card-title"><a href={url}>{post.data.title}</a></h2>
    {
      (post.data.date || showCategory) && (
        <div class="meta">
          {post.data.date && (
            <>
              {formatDate(post.data.date)}
              {showCategory && ' | '}
            </>
          )}
          {showCategory && (
            <>
              {copy.labels.category}:{' '}
              <a href={`/category/${encodeURIComponent(post.data.category)}/`}>
                {post.data.category}
              </a>
            </>
          )}
        </div>
      )
    }
    {post.data.description && <p class="excerpt">{post.data.description}</p>}
    <div class="tag-list">
      {
        post.data.tags.map((tag: string) => (
          <a class="tag" href={tagUrl(tag)}>
            #{tag}
          </a>
        ))
      }
    </div>
  </div>
</article>
