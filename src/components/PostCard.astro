---
import type { CollectionEntry } from 'astro:content';
import { firstExternalImage, formatDate, postUrl, tagUrl } from '../lib';
import { copy } from '../site.config';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const url = postUrl(post);
const showCategory = post.data.category !== copy.contentDefaults.category;
const image = firstExternalImage(post.body ?? '');
---

<article class="post-card" data-post-url={url}>
  <div class="post-card-content">
    <h2 class="post-card-title"><a href={url}>{post.data.title}</a></h2>
    {
      (post.data.date || showCategory) && (
        <div class="meta">
          {post.data.date && (
            <>
              {formatDate(post.data.date)}
              {showCategory && ' | '}
            </>
          )}
          {showCategory && (
            <>
              {copy.labels.category}:{' '}
              <a href={`/category/${encodeURIComponent(post.data.category)}/`}>
                {post.data.category}
              </a>
            </>
          )}
        </div>
      )
    }
    {post.data.description && <p class="excerpt">{post.data.description}</p>}
    <div class="tag-list">
      {
        post.data.tags.map((tag: string) => (
          <a class="tag" href={tagUrl(tag)}>
            #{tag}
          </a>
        ))
      }
    </div>
  </div>
  {
    image && (
      <a class="post-card-image-link" href={url}>
        <img
          class="post-card-image"
          src={image.src}
          alt={image.alt || post.data.title}
          width="120"
          height="90"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>
    )
  }
</article>
