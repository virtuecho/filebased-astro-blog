---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { render } from 'astro:content';
import { formatDate, tagUrl } from '../lib';
import { copy } from '../site.config';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1 class="article-title">{post.data.title}</h1>
    <div class="article-meta meta">
      {
        post.data.date && (
          <>
            {copy.labels.published}: {formatDate(post.data.date)} |{' '}
          </>
        )
      }
      {copy.labels.category}: <a
        href={`/category/${encodeURIComponent(post.data.category)}/`}
        >{post.data.category}</a
      >
      {
        post.data.updated && (
          <>
            {' '}
            | {copy.labels.updated}: {formatDate(post.data.updated)}
          </>
        )
      }
    </div>
    <div class="tag-list">
      {
        post.data.tags.map((tag: string) => (
          <a class="tag" href={tagUrl(tag)}>
            #{tag}
          </a>
        ))
      }
    </div>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const blocks = document.querySelectorAll<HTMLPreElement>(
    '.article-body pre[data-language="mermaid"]',
  );

  if (blocks.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'neutral',
    });

    for (const block of blocks) {
      const fallback = block.cloneNode(true);
      const source = block.textContent ?? '';
      block.className = 'mermaid';
      block.removeAttribute('style');
      block.removeAttribute('data-language');
      block.removeAttribute('tabindex');
      block.textContent = source;

      try {
        await mermaid.run({ nodes: [block] });
      } catch (error) {
        console.error('Could not render Mermaid diagram:', error);
        block.replaceWith(fallback);
      }
    }
  }
</script>
