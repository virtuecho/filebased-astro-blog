---
import BaseLayout from '../layouts/BaseLayout.astro';
import { countItems, getPosts, tagUrl } from '../lib';
import { copy } from '../site.config';
const posts = await getPosts();
const tags = countItems(posts.flatMap((p) => p.data.tags));
---

<BaseLayout title={copy.pages.tagsTitle}>
  <h1 class="page-title">{copy.pages.tagsTitle}</h1>
  <div class="tag-list">
    {
      tags.map(([name, count]) => (
        <a class="tag" href={tagUrl(name)}>
          {name} {count}
        </a>
      ))
    }
  </div>
</BaseLayout>
