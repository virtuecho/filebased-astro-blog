---
import PostList from '../../../components/PostList.astro';
import { getPosts, groupByMonth, paginatePosts } from '../../../lib';
import { copy } from '../../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...groupByMonth(posts).entries()].flatMap(([ym, monthPosts]) => {
    const [year, month] = ym.split('/');
    const firstPage = paginatePosts(monthPosts)[0];
    if (!firstPage) return [];
    return [
      {
        params: { year, month },
        props: {
          year,
          month,
          posts: firstPage.posts,
          totalPages: firstPage.totalPages,
        },
      },
    ];
  });
}

const { year, month, posts, totalPages } = Astro.props;
const title = `${copy.labels.archive}: ${year}/${month}`;
const baseUrl = `/archives/${year}/${month}/`;
---

<PostList
  title={title}
  posts={posts}
  baseUrl={baseUrl}
  currentPage={1}
  totalPages={totalPages}
/>
