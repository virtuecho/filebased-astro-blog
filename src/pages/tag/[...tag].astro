---
import PostList from '../../components/PostList.astro';
import { getPosts, paginatePosts, tagUrl } from '../../lib';
import { copy } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.flatMap((tag) => {
    const firstPage = paginatePosts(
      posts.filter((post) => post.data.tags.includes(tag)),
    )[0];
    if (!firstPage) return [];
    return [
      {
        params: { tag },
        props: {
          tag,
          posts: firstPage.posts,
          totalPages: firstPage.totalPages,
        },
      },
    ];
  });
}

const { tag, posts, totalPages } = Astro.props;
const title = `${copy.labels.tag}: ${tag}`;
const baseUrl = tagUrl(tag);
---

<PostList
  title={title}
  posts={posts}
  baseUrl={baseUrl}
  currentPage={1}
  totalPages={totalPages}
/>
