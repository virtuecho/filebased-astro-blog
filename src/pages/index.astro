---
import PostList from '../components/PostList.astro';
import { getPosts, paginatePosts } from '../lib';
import { copy } from '../site.config';
const posts = await getPosts();
const firstPage = paginatePosts(posts)[0];
---

<PostList
  title={copy.home.title}
  pageTitle={copy.site.title}
  posts={firstPage?.posts ?? []}
  baseUrl="/"
  currentPage={1}
  totalPages={firstPage?.totalPages ?? 0}
  emptyMessage={copy.home.empty}
/>
