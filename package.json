{
  "name": "astro-file-blog-template",
  "version": "0.1.0",
  "description": "An Astro static blog template for Obsidian-friendly Markdown.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "astro --config .config/astro.config.mjs dev",
    "build": "pnpm typecheck && astro --config .config/astro.config.mjs build",
    "preview": "astro --config .config/astro.config.mjs preview",
    "typecheck": "astro --config .config/astro.config.mjs check --tsconfig tsconfig.json",
    "lint": "eslint --config .config/eslint.config.js .",
    "format": "prettier --config .config/prettier.config.cjs --ignore-path .gitignore --ignore-path .config/.prettierignore --write .",
    "format:check": "prettier --config .config/prettier.config.cjs --ignore-path .gitignore --ignore-path .config/.prettierignore --check .",
    "test": "tsx --test tests/obsidian-markdown.test.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@astrojs/rss": "latest",
    "@quartz-community/remark-obsidian": "^1.1.0",
    "astro": "latest",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.45",
    "mermaid": "^12.0.0",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "^7.0.1",
    "typescript": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
